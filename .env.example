# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# ใช้เมื่อรัน backend นอก Docker (docker-compose จะ override ค่านี้เอง)
DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis

# สุ่มค่ายาวๆ: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# คีย์เข้ารหัส token ของ Tuya/FlowAccount ในฐานข้อมูล
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# mock = บ้านจำลองในหน่วยความจำ, live = ต่อ Tuya Cloud จริง
TUYA_MODE=mock
# Data center ตามที่เลือกตอนสร้าง Cloud Project เช่น
#   https://openapi.tuyaus.com (Western America), https://openapi.tuyaeu.com (Central Europe),
#   https://openapi.tuyain.com (India), https://openapi.tuyacn.com (China),
#   https://openapi-sg.iotbing.com (Singapore)
TUYA_ENDPOINT=https://openapi.tuyaus.com
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# UID ของบัญชีแอป Tuya Smart ที่ link ไว้ (Cloud Project > Devices > Link App Account)
TUYA_USER_UID=
# เว้นว่างได้ ระบบจะใช้บ้านหลังแรกของบัญชี
TUYA_HOME_ID=

# Pulsar: รับสถานะอุปกรณ์แบบเรียลไทม์ (ทำงานเฉพาะ TUYA_MODE=live)
# ต้องเปิด Message Service ใน Cloud Project ก่อน
TUYA_PULSAR_ENABLED=true
# เว้นว่างได้ ระบบจะเดาจาก TUYA_ENDPOINT เช่น wss://mqe.tuyaus.com:8285/
TUYA_PULSAR_ENDPOINT=
# event = production, event-test = ช่องทดสอบใน Tuya console
TUYA_PULSAR_ENV=event
# Check IR air conditioners every N seconds for changes made in the Tuya app (0 = off)
IR_AC_POLL_SECONDS=30

# Claude (JARVIS Core) สร้าง key ที่ https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = ตอบเร็ว เหมาะกับคำสั่งสั้นๆ, medium/high = คิดละเอียดขึ้นแต่ช้าและแพงขึ้น
CLAUDE_EFFORT=low
TIMEZONE=Asia/Bangkok

# จำกัดจำนวนครั้งต่อนาที
RATE_LIMIT_CONTROL_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=5

# เสียงตอบของ JARVIS: edge = เสียงผู้หญิง Premwadee ของ Microsoft Edge (ฟรี ไม่ต้องมี key), browser = เสียงของเบราว์เซอร์
TTS_ENGINE=edge
TTS_VOICE=th-TH-PremwadeeNeural
# ความเร็ว (+0% = ปกติ) และระดับเสียง (ยิ่งบวกมากยิ่งแหลมสดใส)
TTS_RATE=-8%
TTS_PITCH=+15Hz
